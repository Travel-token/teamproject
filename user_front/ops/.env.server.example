# Copy this file to .env.server and replace every CHANGE_ME value.
DB_URL=jdbc:mysql://127.0.0.1:3306/travel_token?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=travel_app
DB_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SESSION_REFRESH_SECRET=CHANGE_ME_DIFFERENT_32_RANDOM_BYTES

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_UPLOAD_DIR=C:/teamproject/uploads
OCR_SERVICE_URL=http://127.0.0.1:8001/ocr
OCR_API_KEY=CHANGE_ME_INTERNAL_OCR_KEY
RECOMMENDATION_BASE_URL=http://127.0.0.1:5050
RECOMMENDATION_API_KEY=CHANGE_ME_INTERNAL_RECOMMENDATION_KEY
RECOMMENDATION_DATA_DIR=C:/teamproject/server-data/recommendation
RECOMMENDATION_HOST=127.0.0.1
RECOMMENDATION_PORT=5050

AUTH_OAUTH_PUBLIC_BASE_URL=https://CHANGE_ME.ngrok-free.app
AUTH_OAUTH_APP_REDIRECT_URI=travelsettle://oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
TOUR_API_SERVICE_KEY=
EXPO_ACCESS_TOKEN=
MARKETING_ADMIN_IDS=
MARKETING_ADMIN_KEY=

PAYMENT_CAPTURE_ENABLED=false
PUSH_ENABLED=false
AUTH_DEV_LOGIN_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# Local executable paths. A dedicated Python 3.11 virtual environment is recommended.
PYTHON_EXE=C:/teamproject/.venv/Scripts/python.exe
OCR_PYTHON_EXE=C:/teamproject/.venv-ocr/Scripts/python.exe
NGROK_EXE=C:/tools/ngrok/ngrok.exe
