{
  "expo": {
    "name": "여행 정산 앱",
    "slug": "travel-settle-app",
    "scheme": "travelsettle",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E8F4FD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "여행 중 주변 장소를 추천해드리기 위해 위치 정보가 필요해요."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "여행 중 주변 장소를 추천해드리기 위해 위치 정보가 필요해요."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 사진을 추가하기 위해 갤러리 접근 권한이 필요해요."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b06a4843-7c81-426a-837b-214e4c581d3a"
      }
    },
    "owner": "parkc.m"
  }
}
