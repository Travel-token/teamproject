<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.back.mapper.ExpenseMapper">

    <resultMap id="categoryExpenseStatResultMap" type="com.example.back.dto.CategoryExpenseStat">
        <result column="category_code"  property="categoryCode" />
        <result column="category_label" property="categoryLabel" />
        <result column="amount"         property="amount" />
    </resultMap>

    <!--
        expenses.payer_member_id -> trip_members.id -> trip_members.user_id 로 연결해
        "내가 결제한" 지출만 집계한다.
    -->
    <select id="selectCategoryStatsByUser" resultMap="categoryExpenseStatResultMap">
        SELECT
            e.category_code                AS category_code,
            c.label                        AS category_label,
            SUM(e.amount)                  AS amount
        FROM expenses e
        JOIN trip_members tm       ON e.payer_member_id = tm.id
        JOIN expense_categories c  ON e.category_code = c.code
        WHERE tm.user_id = #{userId}
        <if test="from != null">
            AND e.spent_at &gt;= #{from}
        </if>
        <if test="to != null">
            AND e.spent_at &lt; DATE_ADD(#{to}, INTERVAL 1 DAY)
        </if>
        GROUP BY e.category_code, c.label, c.sort_order
        ORDER BY c.sort_order ASC
    </select>

</mapper>
