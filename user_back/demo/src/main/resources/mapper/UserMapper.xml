<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.back.mapper.UserMapper">


    <select id="findByEmail"
            resultType="com.example.back.vo.UserVo">

        SELECT *
        FROM users
        WHERE email = #{email}

    </select>


    <insert id="save">

        INSERT INTO users(

            email,
            name,
            login_provider,
            profile_emoji,
            status

        )

        VALUES(

            #{email},
            #{name},
            #{loginProvider},
            #{profileEmoji},
            #{status}

        )

    </insert>


    <delete id="delete">

        DELETE
        FROM users
        WHERE id = #{id}

    </delete>

</mapper>